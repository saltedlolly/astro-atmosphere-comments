{
  "name": "astro-atmosphere-comments",
  "version": "0.7.0",
  "description": "Atmosphere Comments for Astro: Bluesky comments, likes, reposts and quote posts for Astro sites; readers sign in with their Atmosphere (AT Protocol) account and respond without leaving the page.",
  "type": "module",
  "license": "MIT",
  "author": "Olly Stedall (https://saltedlolly.com)",
  "homepage": "https://github.com/saltedlolly/astro-atmosphere-comments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saltedlolly/astro-atmosphere-comments.git"
  },
  "bugs": "https://github.com/saltedlolly/astro-atmosphere-comments/issues",
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "bluesky",
    "atproto",
    "atmosphere",
    "comments",
    "likes",
    "oauth",
    "at-protocol",
    "reposts",
    "i18n"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./AtmosphereComments.astro": "./components/AtmosphereComments.astro",
    "./AtmosphereReactions.astro": "./components/AtmosphereReactions.astro"
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "virtual.d.ts",
    "components",
    "lib",
    "routes",
    "assets",
    "locales",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@atproto/api": "^0.30.3",
    "@atproto/oauth-client-browser": "^0.5.11"
  }
}
