---
// Subscribe to the site's Standard.site publication, with a ⌄ menu: a note
// on what subscribing does, then the publication on Standard Reader and
// Leaflet (and any links of the site's own). Following on Bluesky is
// separate: AtmosphereFollow's `menu` style, beside this one under each
// post. Feeds (RSS) aren't here either: they're for the site's own pages.
// Shown only with the integration's `standardSite` option, and only with
// JavaScript.
//
// Placed anywhere, such as a blog's list of posts. The Subscribe button
// itself is worked by AtmosphereReactions, which offers signing in, so put
// that in the layout too. AtmosphereComments uses this component for the one
// under each post, and works that button itself.
//
// Props:
//   align     which edge the menu lines up with: "start" (default) or "end"
//             (for a button near the right-hand edge, so the menu opens leftwards)
//   links     more menu items, after the built-in ones: [{ label, href }]
//   button    just a button, with no menu, for a page all about following
//             (such as Friendly Feed's): the Standard.site logo and "Subscribe to blog
//             posts" (or `label`), then "✓ Subscribed" with the reader's own
//             avatar. Signed out, pressing it offers signing in, as usual.
//   label     the button's text with `button`
//   class     classes for the button, with `button`
//   (copyUrl, from before 0.9.0, and bluesky, from before 0.10.0, are
//   accepted and ignored.)
//   locale, messages  as for AtmosphereComments
import settings from "../lib/settings";
import { messagesFor, pickLocale, translate, translateHtml } from "../lib/i18n";
import { escapeHtml } from "../lib/translate";
import "./atmosphere.css";

interface Props {
  align?: "start" | "end";
  copyUrl?: string;
  links?: { label: string; href: string }[];
  bluesky?: string;
  button?: boolean;
  label?: string;
  class?: string;
  locale?: string;
  messages?: Record<string, string>;
}

const { align = "start", links = [] } = Astro.props;
const lang = pickLocale(Astro.props.locale, settings.locale, Astro.currentLocale);
const messages = messagesFor(lang, { ...settings.messages, ...Astro.props.messages });
const t = (key: string) => translate(messages, lang, key);
const th = (key: string, html: Record<string, string>) => translateHtml(messages, lang, key, html);
const link = (href: string, text: string) => `<a href="${escapeHtml(href)}" target="_blank" rel="noopener">${escapeHtml(text)}</a>`;

const publication = settings.standardSite?.publication ?? "";
// at://<did>/site.standard.publication/<rkey>
const [, , did = "", , rkey = ""] = publication.split("/");
---

{publication && Astro.props.button && (
  <button
    type="button"
    class:list={["atmo__action", "atmo-button", Astro.props.class]}
    data-atmosphere-subscribe
    data-pagefind-ignore
    hidden
  >
    <!-- The Standard.site logo, from https://tangled.org/standard.site/standard.site (MIT, © 2025 Standard.site; see assets/LICENSE-standard-site). -->
    <svg class="atmo-button__filled" viewBox="0 0 28 28" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M13.7848 0.065714C13.9147 -0.0219047 14.0853 -0.0219047 14.2152 0.065714C14.3672 0.16831 14.4487 1.17325 14.6113 3.18324L14.6679 3.88175H18.5308C21.5884 3.88179 24.067 6.36063 24.067 9.41828V10.3728H22.1579V9.41828C22.1579 7.415 20.5341 5.79089 18.5308 5.79086H14.8257C14.9975 7.72432 15.1695 8.84869 15.6731 9.76909C16.2205 10.7696 17.0392 11.5976 18.0361 12.1592C19.167 12.7962 20.6187 12.9381 23.522 13.2213L25.1166 13.3766C26.9289 13.5534 27.8355 13.6419 27.9364 13.793C28.0224 13.9222 28.0211 14.0905 27.933 14.2184C27.83 14.368 26.9222 14.4423 25.107 14.5906L24.067 14.6755V18.5819C24.0669 21.6396 21.5884 24.1181 18.5308 24.1182H14.6632L14.6113 24.7719C14.4489 26.8111 14.3676 27.831 14.2155 27.9342C14.0855 28.0219 13.9148 28.0219 13.7848 27.9342C13.6327 27.8315 13.5514 26.8117 13.389 24.7719L13.3368 24.1182H9.36726C6.30968 24.1181 3.83082 21.6395 3.83079 18.5819V17.6274H5.73987V18.5819C5.73991 20.5852 7.36404 22.209 9.36726 22.209H13.1814C13.0072 20.202 12.8353 19.0446 12.3157 18.1037C11.7575 17.0929 10.9223 16.2602 9.90699 15.7024C8.75503 15.0696 7.27799 14.9489 4.32422 14.7075L2.89302 14.5906C1.07778 14.4423 0.170021 14.368 0.0669912 14.2184C-0.0210463 14.0905 -0.0224419 13.9222 0.0635733 13.793C0.164352 13.6418 1.07092 13.5534 2.88339 13.3766L3.83079 13.284V9.41828C3.83079 6.36064 6.30966 3.8818 9.36726 3.88175H13.3324L13.389 3.18324C13.5515 1.17355 13.6328 0.168553 13.7848 0.065714ZM22.1579 14.8352C20.1779 15.0125 19.0285 15.1887 18.0933 15.7024C17.0779 16.2602 16.2425 17.0929 15.6843 18.1037C15.1647 19.0446 14.9928 20.202 14.8186 22.209H18.5308C20.534 22.209 22.1578 20.5852 22.1579 18.5819V14.8352ZM9.36726 5.79086C7.36401 5.7909 5.73987 7.41501 5.73987 9.41828V13.0957C7.82821 12.8811 9.01013 12.6965 9.96385 12.1592C10.9608 11.5976 11.7795 10.7696 12.3269 9.76909C12.8305 8.84869 13.0028 7.72433 13.1746 5.79086H9.36726Z" /></svg>
    <img class="atmo-button__me" data-label-on data-atmosphere-me-avatar alt="" />
    <span data-label-on>{t("subscribe.subscribed")}</span>
    <span data-label-off>{Astro.props.label ?? t("subscribe.blogPosts")}</span>
  </button>
)}
{publication && !Astro.props.button && (
  <atmosphere-subscribe class:list={["atmo-subscribe", align === "end" && "atmo-subscribe--end"]} data-subscribe-panel data-pagefind-ignore hidden>
    <button type="button" class="atmo__action atmo-subscribe__button" data-atmosphere-subscribe hidden>
      <!-- The Standard.site logo, from https://tangled.org/standard.site/standard.site (MIT, © 2025 Standard.site; see assets/LICENSE-standard-site): subscribing saves a Standard.site subscription. -->
      <svg class="atmo-button__filled" viewBox="0 0 28 28" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M13.7848 0.065714C13.9147 -0.0219047 14.0853 -0.0219047 14.2152 0.065714C14.3672 0.16831 14.4487 1.17325 14.6113 3.18324L14.6679 3.88175H18.5308C21.5884 3.88179 24.067 6.36063 24.067 9.41828V10.3728H22.1579V9.41828C22.1579 7.415 20.5341 5.79089 18.5308 5.79086H14.8257C14.9975 7.72432 15.1695 8.84869 15.6731 9.76909C16.2205 10.7696 17.0392 11.5976 18.0361 12.1592C19.167 12.7962 20.6187 12.9381 23.522 13.2213L25.1166 13.3766C26.9289 13.5534 27.8355 13.6419 27.9364 13.793C28.0224 13.9222 28.0211 14.0905 27.933 14.2184C27.83 14.368 26.9222 14.4423 25.107 14.5906L24.067 14.6755V18.5819C24.0669 21.6396 21.5884 24.1181 18.5308 24.1182H14.6632L14.6113 24.7719C14.4489 26.8111 14.3676 27.831 14.2155 27.9342C14.0855 28.0219 13.9148 28.0219 13.7848 27.9342C13.6327 27.8315 13.5514 26.8117 13.389 24.7719L13.3368 24.1182H9.36726C6.30968 24.1181 3.83082 21.6395 3.83079 18.5819V17.6274H5.73987V18.5819C5.73991 20.5852 7.36404 22.209 9.36726 22.209H13.1814C13.0072 20.202 12.8353 19.0446 12.3157 18.1037C11.7575 17.0929 10.9223 16.2602 9.90699 15.7024C8.75503 15.0696 7.27799 14.9489 4.32422 14.7075L2.89302 14.5906C1.07778 14.4423 0.170021 14.368 0.0669912 14.2184C-0.0210463 14.0905 -0.0224419 13.9222 0.0635733 13.793C0.164352 13.6418 1.07092 13.5534 2.88339 13.3766L3.83079 13.284V9.41828C3.83079 6.36064 6.30966 3.8818 9.36726 3.88175H13.3324L13.389 3.18324C13.5515 1.17355 13.6328 0.168553 13.7848 0.065714ZM22.1579 14.8352C20.1779 15.0125 19.0285 15.1887 18.0933 15.7024C17.0779 16.2602 16.2425 17.0929 15.6843 18.1037C15.1647 19.0446 14.9928 20.202 14.8186 22.209H18.5308C20.534 22.209 22.1578 20.5852 22.1579 18.5819V14.8352ZM9.36726 5.79086C7.36401 5.7909 5.73987 7.41501 5.73987 9.41828V13.0957C7.82821 12.8811 9.01013 12.6965 9.96385 12.1592C10.9608 11.5976 11.7795 10.7696 12.3269 9.76909C12.8305 8.84869 13.0028 7.72433 13.1746 5.79086H9.36726Z" /></svg>
      <span data-atmosphere-subscribe-label>{t("subscribe.subscribe")}</span>
    </button>
    <button type="button" class="atmo__action atmo-subscribe__more" aria-label={t("subscribe.more")} title={t("subscribe.more")} aria-expanded="false" data-menu-more>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <div class="atmo-subscribe__menu" data-menu hidden>
      <div class="atmo-subscribe__note">
        <p>
          <Fragment
            set:html={th("subscribe.panelText", {
              standardSite: link("https://standard.site", "Standard.site"),
              standardReader: link("https://standard-reader.app", "Standard Reader"),
              leaflet: link("https://leaflet.pub", "Leaflet"),
            })}
          />
        </p>
      </div>
      <a href={`https://standard-reader.app/p/${did}/${rkey}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" /></svg><span>{t("subscribe.standardReader")}</span></a>
      <a href={`https://leaflet.pub/lish/${did}/${rkey}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" /></svg><span>{t("subscribe.leaflet")}</span></a>
      {links.map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" /></svg><span>{label}</span></a>
      ))}
    </div>
  </atmosphere-subscribe>
)}

<script>
  // The ⌄ menu (lib/client/menu.ts). Shows itself once this runs, except
  // under a post, where AtmosphereComments shows it when the comments are ready.
  import { setUpMenu } from "../lib/client/menu";
  class AtmosphereSubscribe extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === undefined && !this.closest("atmosphere-comments")) this.hidden = false;
      setUpMenu(this);
    }
  }
  if (!customElements.get("atmosphere-subscribe")) customElements.define("atmosphere-subscribe", AtmosphereSubscribe);
</script>
