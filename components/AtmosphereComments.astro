---
// The comment box under a post: "Respond with your Atmosphere Account", then,
// once signed in, Like, Repost and Quote buttons and a box to write a
// comment (a reply to the post's announcement, or to one of its comments).
//
// Props:
//   post   the announcement's AT URI (at://did/app.bsky.feed.post/rkey).
//   label   the small words on the button above "Atmosphere Account"
//           (default "Respond with your").
//   credit  a small "Comments by astro-atmosphere-comments" link under the
//           comments (default true; false hides it).
//
// Quote shows a preview of the reader's post with the announcement quoted
// inside, avatars and link-card picture included (passed on by this site).
//
// Typing @ and the start of a handle suggests accounts to mention.
//
// Comments: under every element on the page with a `data-atmosphere-uri`
// attribute (a comment's AT URI) the component adds Reply, Like and Repost.
// `data-atmosphere-author` names who wrote it, and `data-atmosphere-likes` /
// `data-atmosphere-reposts` give its counts.
//
// Colours come from CSS custom properties with sensible defaults, so a site
// can match its own theme: --atmo-text, --atmo-muted, --atmo-accent,
// --atmo-on-accent, --atmo-border, --atmo-field-bg, --atmo-radius.
//
// After posting, the element fires `atmosphere:commented` (detail: { uri, url,
// text, author, createdAt, quote, parent }), and after a like or repost (or
// undoing one) `atmosphere:reacted` (detail: { kind, on, author }), so a site
// can show it straight away.
import logo from "../assets/union.svg?url";
import settings from "../lib/settings";

interface Props {
  /**
   * The post's announcement on Bluesky: its AT URI or bsky.app address. If
   * left out, the page's Standard.site record (<link rel="site.standard.document">)
   * is used to find it.
   */
  post?: string;
  label?: string;
  /** The badge on comments by the site's own accounts. */
  authorLabel?: string;
  /** A small "Comments by astro-atmosphere-comments" link under the comments. Default true. */
  credit?: boolean;
}

const { post = "", label = "Respond with your", authorLabel = "Author", credit = true } = Astro.props;
const CREDIT_URL = "https://saltedlolly.com/2026/11/03/comment-like-and-repost-with-your-bluesky-account/";
const { base } = settings;
const returnTo = `${Astro.url.pathname}#atmosphere-comments`;
---

<atmosphere-comments class="atmo" id="atmosphere-comments" data-post={post} data-base={base} data-author-label={authorLabel}>
  <div class="atmo-reactions" data-reactions data-pagefind-ignore hidden></div>

  <div class="atmo__signed-out" data-view="signed-out" data-pagefind-ignore>
    <button type="button" class="atmo__badge-button" data-open-login aria-expanded="false" aria-controls="atmo-login" hidden>
      <span class="atmo__logo" style={`--atmo-logo: url("${logo}")`} aria-hidden="true"></span>
      <span class="atmo__badge-text">
        <span class="atmo__badge-small">{label}</span>
        <span class="atmo__badge-big">Atmosphere Account</span>
      </span>
    </button>
    <form class="atmo__login" id="atmo-login" method="post" action={`${base}/login`} data-login-form>
      <label for="atmo-handle">Sign in to leave a comment, like or repost</label>
      <p class="atmo__hint">Any <a href="https://atmosphereaccount.com">Atmosphere account</a> works, including <a href="https://bsky.app">Bluesky</a>: one account for a whole network of open apps.</p>
      <div class="atmo__row">
        <input
          id="atmo-handle"
          name="handle"
          type="text"
          inputmode="url"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          placeholder="alice.bsky.social"
          required
        />
        <input type="hidden" name="returnTo" value={returnTo} />
        <button type="submit" class="atmo__button">Continue</button>
      </div>
      <p class="atmo__hint">
        You'll approve this on your account's own site (Bluesky's, for most people); your password
        is never shared here.
        No account yet? <a href="https://atmosphereaccount.com">Create a free Atmosphere account</a>.
      </p>
    </form>
  </div>

  <div class="atmo__signed-in" data-view="signed-in" data-pagefind-ignore hidden>
    <div class="atmo__actions" role="group" aria-label="Respond to this post">
      <button type="button" class="atmo__action" data-react="like" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.4-7.5-10.1A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8c0 5.7-7.5 10.1-7.5 10.1Z" /></svg>
        <span data-label-off>Like</span><span data-label-on>Liked</span>
      </button>
      <button type="button" class="atmo__action" data-react="repost" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h10l-3-3M17 16H7l3 3M5 13V9.5A1.5 1.5 0 0 1 6.5 8M19 11v3.5a1.5 1.5 0 0 1-1.5 1.5" /></svg>
        <span data-label-off>Repost</span><span data-label-on>Reposted</span>
      </button>
      <button type="button" class="atmo__action" data-quote>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 18h5v-5H6.5A4.5 4.5 0 0 1 11 8.5V7a6 6 0 0 0-6 6Zm9 0h5v-5h-3.5A4.5 4.5 0 0 1 20 8.5V7a6 6 0 0 0-6 6Z" /></svg>
        <span>Quote</span>
      </button>
    </div>

    <form class="atmo__composer" data-composer>
      <p class="atmo__context" data-context hidden>
        <span data-context-text></span>
        <button type="button" class="atmo__link-button" data-cancel-context>Cancel</button>
      </p>
      <label for="atmo-text" class="atmo__as">
        <span class="atmo__avatar atmo__avatar--me" data-me-avatar aria-hidden="true"></span>
        <span><span data-verb>Comment</span> as <strong data-handle></strong></span>
      </label>
      <div class="atmo__field">
        <textarea
          id="atmo-text"
          name="text"
          rows="4"
          required
          aria-autocomplete="list"
          aria-controls="atmo-suggestions"
          aria-expanded="false"></textarea>
        <ul class="atmo__suggestions" id="atmo-suggestions" role="listbox" aria-label="Accounts to mention" data-suggestions hidden></ul>
      </div>
      <figure class="atmo__preview" data-preview hidden>
        <figcaption>How your post will look</figcaption>
        <div class="atmo__preview-post">
          <span class="atmo__avatar" data-preview-avatar aria-hidden="true"></span>
          <div class="atmo__preview-body">
            <p class="atmo__preview-author"><strong data-preview-name></strong> <span data-preview-handle></span> <span>· now</span></p>
            <p class="atmo__preview-text" data-preview-text></p>
            <div class="atmo__quoted">
              <p class="atmo__preview-author">
                <span class="atmo__avatar atmo__avatar--small" data-quoted-avatar aria-hidden="true"></span>
                <strong data-quoted-name></strong> <span data-quoted-handle></span>
              </p>
              <p class="atmo__preview-text" data-quoted-text></p>
              <div class="atmo__card" data-card hidden>
                <img data-card-image alt="" hidden />
                <div>
                  <strong data-card-title></strong>
                  <span data-card-description></span>
                  <span class="atmo__card-domain" data-card-domain></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </figure>
      <div class="atmo__row atmo__row--end">
        <span class="atmo__count" data-count aria-live="polite"></span>
        <button type="button" class="atmo__link-button" data-sign-out>Sign out</button>
        <button type="submit" class="atmo__button" data-submit>Post comment</button>
      </div>
    </form>
  </div>

  <p class="atmo__status" data-status role="status" data-pagefind-ignore></p>

  {/* Anything the site wants between the comment box and the comments. */}
  <slot name="after-box" />

  <ol class="atmo-comments" data-replies data-pagefind-ignore></ol>

  {/* Anything the site wants after the comments (other responses, say). */}
  <slot />

  {credit && (
    <p class="atmo__credit" data-credit data-pagefind-ignore>
      Comments by <a href={CREDIT_URL}>astro-atmosphere-comments</a>
    </p>
  )}
</atmosphere-comments>

<script>
  const MAX = 300;
  const graphemes = new Intl.Segmenter();
  const count = (text: string) => [...graphemes.segment(text.trim())].length;

  const MESSAGES: Record<string, string> = {
    "signed-in": "You're signed in. You can comment, like or repost below.",
    "sign-in-failed": "Signing in didn't finish. Please try again.",
    "account-not-found": "We couldn't find that account. Check the handle and try again.",
    "invalid-handle": "That doesn't look like a handle. It's usually something like alice.bsky.social.",
    "signed-out": "You've been signed out. Please sign in again.",
    "new-permissions": "This site can now also like and repost for you, so it needs your permission again. Please sign in again.",
    "too-long": `Posts can be up to ${MAX} characters.`,
    "too-many": "You're going quickly. Please wait a minute and try again.",
    error: "That didn't work. Please try again.",
  };

  type Posted = { uri: string; url: string; quote: boolean };
  type Suggestion = { handle: string; displayName?: string; avatar?: string };

  class AtmosphereComments extends HTMLElement {
    connectedCallback() {
      const base = this.dataset.base ?? "/atmosphere";
      // The announcement's AT URI. A bsky.app address or the page's
      // Standard.site record is turned into one when the thread loads.
      let post = this.dataset.post?.startsWith("at://") ? this.dataset.post : "";
      const $ = <T extends Element>(selector: string) => this.querySelector<T>(selector)!;
      const signedOut = $<HTMLElement>("[data-view='signed-out']");
      const signedIn = $<HTMLElement>("[data-view='signed-in']");
      const composer = $<HTMLFormElement>("[data-composer]");
      // A clean copy of the comment box, for reply boxes under comments.
      const template = composer.cloneNode(true) as HTMLFormElement;
      const loginButton = $<HTMLButtonElement>("[data-open-login]");
      const loginForm = $<HTMLFormElement>("[data-login-form]");
      const status = $<HTMLElement>("[data-status]");
      let isSignedIn = false;
      let me: { did?: string; handle?: string; displayName?: string; avatar?: string } = {};
      // What the main box is doing: a comment on the post, or a quote post.
      let mainMode: "comment" | "quote" = "comment";

      const say = (message: string) => (status.textContent = message);
      const send = (path: string, body: unknown) =>
        fetch(`${base}/${path}`, {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
      // Elements this script creates get the component's marker attribute, so
      // Astro's scoped styles still reach them.
      const scoped = <T extends HTMLElement>(element: T): T => {
        for (const { name, value } of this.attributes) {
          if (name.startsWith("data-astro-cid")) element.setAttribute(name, value);
        }
        return element;
      };

      // The thread: likes and reposts above the comment box, and the comments
      // below it, read through this site (routes/thread.ts).
      type Person = { did: string; handle: string; displayName?: string; avatar?: string; url: string };
      type Reply = {
        uri: string;
        url: string;
        author: Person;
        byAuthor: boolean;
        createdAt: string;
        text: { text: string; href: string | null }[];
        depth: number;
        likeCount: number;
        repostCount: number;
      };
      type Thread = { uri: string; likeCount: number; repostCount: number; likes: Person[]; reposts: Person[]; replies: Reply[] };
      let thread: Thread | null = null;
      const reactionsBox = $<HTMLElement>("[data-reactions]");
      const repliesList = $<HTMLOListElement>("[data-replies]");
      const authorLabel = this.dataset.authorLabel || "Author";
      const nameOf = (person: Pick<Person, "handle" | "displayName">) => person.displayName || `@${person.handle}`;
      const dates = new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
      const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text?: string) => {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      };
      const avatarOf = (person: Pick<Person, "handle" | "displayName" | "avatar">, className: string) => {
        if (person.avatar) return Object.assign(make("img", className), { src: person.avatar, alt: "", loading: "lazy" as const });
        const initial = make("span", `${className} atmo-avatar-initial`, nameOf(person).replace("@", "").charAt(0).toUpperCase());
        initial.setAttribute("aria-hidden", "true");
        return initial;
      };

      const renderReactions = () => {
        if (!thread) return;
        const groups = [
          { kind: "like", count: thread.likeCount, people: thread.likes },
          { kind: "repost", count: thread.repostCount, people: thread.reposts },
        ].filter((group) => group.count > 0);
        reactionsBox.hidden = !groups.length;
        reactionsBox.replaceChildren(
          ...groups.map(({ kind, count, people }) => {
            const group = make("div", "atmo-reactions__group");
            group.dataset.reaction = kind;
            group.append(make("p", "atmo-reactions__count", `${count} ${kind}${count === 1 ? "" : "s"}`));
            const faces = make("ul", "atmo-facepile");
            for (const person of people) {
              const link = Object.assign(make("a"), { href: person.url, title: nameOf(person), rel: "ugc nofollow noopener" });
              link.setAttribute("aria-label", nameOf(person));
              link.append(avatarOf(person, "atmo-facepile__avatar"));
              const item = make("li");
              item.append(link);
              faces.append(item);
            }
            if (count > people.length) faces.append(Object.assign(make("li"), { className: "atmo-facepile__more", textContent: `+${count - people.length}` }));
            group.append(faces);
            return group;
          }),
        );
      };

      const replyElement = (reply: Reply) => {
        const item = make("li", `atmo-comment${reply.byAuthor ? " atmo-comment--author" : ""}${reply.depth ? " atmo-comment--nested" : ""}`);
        if (reply.depth) item.style.setProperty("--depth", String(Math.min(reply.depth, 3)));
        item.dataset.atmosphereUri = reply.uri;
        item.dataset.atmosphereAuthor = nameOf(reply.author);
        item.dataset.atmosphereLikes = String(reply.likeCount);
        item.dataset.atmosphereReposts = String(reply.repostCount);
        const author = Object.assign(make("a", "atmo-comment__author", nameOf(reply.author)), {
          href: reply.author.url,
          rel: "ugc nofollow noopener",
        });
        const who = make("div", "atmo-comment__who");
        who.append(author);
        if (reply.byAuthor) who.append(make("span", "atmo-comment__badge", authorLabel));
        const date = Object.assign(make("a", "atmo-comment__date"), { href: reply.url, rel: "ugc nofollow noopener" });
        const time = Object.assign(make("time"), { dateTime: reply.createdAt, textContent: reply.createdAt ? dates.format(new Date(reply.createdAt)) : "" });
        date.append(time, make("span", "", " · view on Bluesky"));
        const names = make("div");
        names.append(who, date);
        const header = make("header", "atmo-comment__header");
        header.append(avatarOf(reply.author, "atmo-comment__avatar"), names);
        const body = make("div", "atmo-comment__body");
        const paragraph = make("p");
        for (const piece of reply.text) {
          paragraph.append(
            piece.href ? Object.assign(make("a", "", piece.text), { href: piece.href, rel: "ugc nofollow noopener" }) : piece.text,
          );
        }
        body.append(paragraph);
        const article = make("article");
        article.append(header, body);
        item.append(article);
        return item;
      };

      // Finds the announcement (given, or from the page's Standard.site record)
      // and shows its thread. Without one there is nothing to respond to.
      // Nothing to respond to: hide the box and likes, but keep whatever the
      // site put in the slots.
      const deactivate = () => {
        for (const part of this.querySelectorAll<HTMLElement>("[data-view], [data-reactions], [data-replies], [data-credit]")) {
          part.hidden = true;
        }
        this.classList.add("is-inactive");
      };
      const loadThread = async () => {
        const given = this.dataset.post ?? "";
        const record = document.querySelector('link[rel="site.standard.document"]')?.getAttribute("href") ?? "";
        const query = given ? `post=${encodeURIComponent(given)}` : record ? `document=${encodeURIComponent(record)}` : "";
        if (!query) {
          deactivate();
          return;
        }
        try {
          const response = await fetch(`${base}/thread?${query}`);
          const data = (await response.json()) as { thread?: Thread | null };
          if (!data.thread) {
            if (!post) deactivate();
            return;
          }
          thread = data.thread;
          post = thread.uri;
          renderReactions();
          repliesList.replaceChildren(...thread.replies.map(replyElement));
        } catch {
          // Without the thread the box still works if the post was given.
          if (!post) deactivate();
        }
      };
      const threadReady = loadThread();

      // A comment just posted, shown at once (Bluesky takes a moment to list it).
      const showPosted = (data: Posted & { text: string; createdAt: string; parent: string | null; author: Person }) => {
        if (data.quote) return;
        const parent = data.parent
          ? repliesList.querySelector<HTMLElement>(`[data-atmosphere-uri="${CSS.escape(data.parent)}"]`)
          : null;
        const depth = parent ? Number(parent.style.getPropertyValue("--depth") || 0) + 1 : 0;
        const item = replyElement({
          uri: data.uri,
          url: data.url,
          author: { ...data.author, url: `https://bsky.app/profile/${encodeURIComponent(data.author.handle)}` },
          byAuthor: false,
          createdAt: data.createdAt,
          text: [{ text: data.text, href: null }],
          depth,
          likeCount: 0,
          repostCount: 0,
        });
        if (parent) parent.after(item);
        else repliesList.append(item);
        item.scrollIntoView({ block: "nearest", behavior: "smooth" });
      };

      // A like or repost of the post, shown at once among the faces.
      const showReaction = (kind: string, on: boolean) => {
        if (!thread || !me.did || !me.handle) return;
        const people = kind === "like" ? thread.likes : thread.reposts;
        const index = people.findIndex((person) => person.did === me.did);
        if (on === index >= 0) return;
        if (on) people.unshift({ did: me.did, handle: me.handle, displayName: me.displayName, avatar: me.avatar, url: `https://bsky.app/profile/${encodeURIComponent(me.handle)}` });
        else people.splice(index, 1);
        if (kind === "like") thread.likeCount = Math.max(0, thread.likeCount + (on ? 1 : -1));
        else thread.repostCount = Math.max(0, thread.repostCount + (on ? 1 : -1));
        renderReactions();
      };

      // With JavaScript, the handle form opens from the Atmosphere button.
      loginButton.hidden = false;
      loginForm.hidden = true;
      const openLogin = () => {
        loginForm.hidden = false;
        loginButton.setAttribute("aria-expanded", "true");
        loginForm.querySelector("input")?.focus();
      };
      loginButton.addEventListener("click", () => {
        if (loginForm.hidden) return openLogin();
        loginForm.hidden = true;
        loginButton.setAttribute("aria-expanded", "false");
      });

      // An avatar picture, or the name's first letter if there isn't one.
      const setAvatar = (slot: HTMLElement, name: string, src?: string) => {
        slot.replaceChildren();
        slot.textContent = name.trim().charAt(0).toUpperCase();
        if (!src) return;
        const img = Object.assign(document.createElement("img"), { src, alt: "" });
        img.onload = () => slot.replaceChildren(img);
      };

      const handleError = (error: string, tell: (message: string) => void = say) => {
        if (error === "signed-out" || error === "new-permissions") void show(false);
        tell(MESSAGES[error] ?? MESSAGES.error);
      };

      const postedMessage = (where: HTMLElement, data: Posted) =>
        where.replaceChildren(
          data.quote ? "Your quote post is on Bluesky. " : "Your comment is posted. ",
          Object.assign(document.createElement("a"), { href: data.url, textContent: "See it on Bluesky →" }),
        );

      // Everything a comment box does: counting characters, @mention
      // suggestions and posting. Used by the main box and every reply box.
      const setUpComposer = (
        form: HTMLFormElement,
        behaviour: {
          extra: () => Record<string, unknown>;
          tell: (message: string) => void;
          onPosted: (data: Posted) => void;
          onInput?: () => void;
        },
      ) => {
        const textarea = form.querySelector("textarea")!;
        const counter = form.querySelector<HTMLElement>("[data-count]")!;
        const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
        const suggestions = form.querySelector<HTMLUListElement>("[data-suggestions]")!;

        const updateCount = () => {
          const used = count(textarea.value);
          counter.textContent = used > MAX - 50 ? `${MAX - used} left` : "";
          counter.classList.toggle("is-over", used > MAX);
        };

        // @mention suggestions, as in the Bluesky app: typing @ and the start
        // of a handle or name lists matching accounts to choose from.
        let options: Suggestion[] = [];
        let active = -1;
        let lookup: number | undefined;
        let latestQuery = "";
        const mentionAtCaret = () => {
          const before = textarea.value.slice(0, textarea.selectionStart);
          const match = /(?:^|[\s(])@([a-zA-Z0-9.-]{1,64})$/.exec(before);
          return match ? { query: match[1], start: before.length - match[1].length - 1 } : null;
        };
        const closeSuggestions = () => {
          suggestions.hidden = true;
          suggestions.replaceChildren();
          options = [];
          active = -1;
          textarea.setAttribute("aria-expanded", "false");
          textarea.removeAttribute("aria-activedescendant");
        };
        const highlight = (index: number) => {
          active = index;
          suggestions.querySelectorAll("li").forEach((item, i) => item.setAttribute("aria-selected", String(i === index)));
          if (index >= 0) textarea.setAttribute("aria-activedescendant", `${suggestions.id}-option-${index}`);
        };
        const choose = (index: number) => {
          const mention = mentionAtCaret();
          const option = options[index];
          if (!mention || !option) return closeSuggestions();
          const after = textarea.value.slice(textarea.selectionStart);
          textarea.value = `${textarea.value.slice(0, mention.start)}@${option.handle} ${after}`;
          const caret = mention.start + option.handle.length + 2;
          textarea.setSelectionRange(caret, caret);
          closeSuggestions();
          textarea.focus();
          updateCount();
          behaviour.onInput?.();
        };
        const showSuggestions = (found: Suggestion[]) => {
          options = found;
          if (!found.length) return closeSuggestions();
          suggestions.replaceChildren(
            ...found.map((option, index) => {
              const item = document.createElement("li");
              item.id = `${suggestions.id}-option-${index}`;
              item.setAttribute("role", "option");
              const avatar = document.createElement("span");
              avatar.className = "atmo__avatar atmo__avatar--small";
              setAvatar(avatar, option.displayName || option.handle, option.avatar);
              const name = Object.assign(document.createElement("strong"), { textContent: option.displayName || option.handle });
              const handle = Object.assign(document.createElement("span"), { textContent: `@${option.handle}` });
              item.append(avatar, name, handle);
              // mousedown keeps the focus in the text box.
              item.addEventListener("mousedown", (event) => event.preventDefault());
              item.addEventListener("click", () => choose(index));
              return item;
            }),
          );
          suggestions.hidden = false;
          textarea.setAttribute("aria-expanded", "true");
          highlight(0);
        };
        const lookUpMention = () => {
          window.clearTimeout(lookup);
          const mention = mentionAtCaret();
          if (!mention) return closeSuggestions();
          latestQuery = mention.query;
          lookup = window.setTimeout(async () => {
            const query = mention.query;
            try {
              const response = await fetch(`${base}/typeahead?q=${encodeURIComponent(query)}`, { credentials: "same-origin" });
              const data = (await response.json()) as { actors?: Suggestion[] };
              if (query === latestQuery) showSuggestions(data.actors ?? []);
            } catch {
              closeSuggestions();
            }
          }, 200);
        };

        textarea.addEventListener("input", () => {
          updateCount();
          behaviour.onInput?.();
          lookUpMention();
        });
        textarea.addEventListener("keydown", (event) => {
          if (suggestions.hidden) return;
          if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            event.preventDefault();
            const step = event.key === "ArrowDown" ? 1 : -1;
            highlight((active + step + options.length) % options.length);
          } else if (event.key === "Enter" || event.key === "Tab") {
            event.preventDefault();
            choose(Math.max(active, 0));
          } else if (event.key === "Escape") {
            event.preventDefault();
            closeSuggestions();
          }
        });
        textarea.addEventListener("blur", () => window.setTimeout(closeSuggestions, 150));

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const text = textarea.value.trim();
          if (!text) return;
          if (count(text) > MAX) return behaviour.tell(MESSAGES["too-long"]);
          submit.disabled = true;
          behaviour.tell("Posting…");
          try {
            const response = await send("comment", { text, root: post, ...behaviour.extra() });
            const data = await response.json();
            if (!response.ok) return handleError(data.error, behaviour.tell);
            textarea.value = "";
            updateCount();
            behaviour.onPosted(data);
            showPosted(data);
            this.dispatchEvent(new CustomEvent("atmosphere:commented", { detail: data, bubbles: true }));
          } catch {
            behaviour.tell(MESSAGES.error);
          } finally {
            submit.disabled = false;
          }
        });

        return { textarea, updateCount };
      };

      // The Quote preview: the reader's words as they type, with the
      // announcement quoted beneath, as Bluesky will show it.
      const preview = $<HTMLElement>("[data-preview]");
      const previewText = $<HTMLElement>("[data-preview-text]");
      let quotedLoaded = false;
      const updatePreviewText = () => {
        const words = main.textarea.value.trim();
        previewText.textContent = words || "Your words appear here.";
        previewText.classList.toggle("is-placeholder", !words);
      };
      const loadQuoted = async () => {
        updatePreviewText();
        if (quotedLoaded) return;
        try {
          const response = await fetch(`${base}/post?uri=${encodeURIComponent(post)}`);
          if (!response.ok) return;
          const quoted = (await response.json()) as {
            author: { handle: string; displayName?: string; avatar?: string };
            text: string;
            external?: { uri: string; title: string; description: string; thumb?: string };
          };
          quotedLoaded = true;
          const quotedName = quoted.author.displayName || quoted.author.handle;
          $<HTMLElement>("[data-quoted-name]").textContent = quotedName;
          setAvatar($<HTMLElement>("[data-quoted-avatar]"), quotedName, quoted.author.avatar);
          $<HTMLElement>("[data-quoted-handle]").textContent = `@${quoted.author.handle}`;
          $<HTMLElement>("[data-quoted-text]").textContent = quoted.text;
          if (quoted.external) {
            $<HTMLElement>("[data-card]").hidden = false;
            $<HTMLElement>("[data-card-title]").textContent = quoted.external.title;
            $<HTMLElement>("[data-card-description]").textContent = quoted.external.description;
            $<HTMLElement>("[data-card-domain]").textContent = new URL(quoted.external.uri).hostname;
            if (quoted.external.thumb) {
              const img = $<HTMLImageElement>("[data-card-image]");
              img.onload = () => (img.hidden = false);
              img.onerror = () => (img.hidden = true);
              img.src = quoted.external.thumb;
            }
          }
        } catch {
          // The preview is a nicety: quoting still works without it.
        }
      };

      // The main box: a comment on the post, or (after Quote) a quote post.
      const setMainMode = (next: "comment" | "quote") => {
        mainMode = next;
        const quoting = next === "quote";
        $<HTMLElement>("[data-context]").hidden = !quoting;
        $<HTMLElement>("[data-context-text]").textContent = quoting ? "Quoting this post on your own account" : "";
        $<HTMLElement>("[data-verb]").textContent = quoting ? "Quote" : "Comment";
        $<HTMLElement>("[data-submit]").textContent = quoting ? "Post quote" : "Post comment";
        preview.hidden = !quoting;
        if (quoting) void loadQuoted();
      };
      const main = setUpComposer(composer, {
        extra: () => (mainMode === "quote" ? { quote: true } : {}),
        tell: say,
        onPosted: (data) => {
          setMainMode("comment");
          postedMessage(status, data);
        },
        onInput: updatePreviewText,
      });
      $<HTMLButtonElement>("[data-cancel-context]").addEventListener("click", () => {
        setMainMode("comment");
        main.textarea.focus();
      });
      $<HTMLButtonElement>("[data-quote]").addEventListener("click", () => {
        setMainMode("quote");
        main.textarea.focus();
      });

      // A reply box of its own under a comment, so the main box stays where
      // it is: the reader can comment on the post or reply to a comment.
      let replyBoxes = 0;
      const openReply = (comment: HTMLElement, author: string) => {
        const open = comment.querySelector<HTMLElement>(":scope > .atmo--inline, :scope article > .atmo--inline");
        if (open) return open.querySelector("textarea")?.focus();
        replyBoxes += 1;
        const id = `atmo-reply-${replyBoxes}`;
        const holder = scoped(Object.assign(document.createElement("div"), { className: "atmo atmo--inline" }));
        const form = template.cloneNode(true) as HTMLFormElement;
        form.querySelector("[data-preview]")?.remove();
        form.querySelector("[data-sign-out]")?.remove();
        const textarea = form.querySelector("textarea")!;
        const suggestions = form.querySelector<HTMLElement>("[data-suggestions]")!;
        textarea.id = `${id}-text`;
        form.querySelector("label")?.setAttribute("for", textarea.id);
        suggestions.id = `${id}-suggestions`;
        textarea.setAttribute("aria-controls", suggestions.id);
        form.querySelector<HTMLElement>("[data-context]")!.hidden = false;
        form.querySelector("[data-context-text]")!.textContent = `Replying to ${author}`;
        form.querySelector("[data-verb]")!.textContent = "Reply";
        form.querySelector("[data-submit]")!.textContent = "Post reply";
        form.querySelector("[data-handle]")!.textContent = me.handle ? `@${me.handle}` : "";
        setAvatar(form.querySelector<HTMLElement>("[data-me-avatar]")!, me.displayName || me.handle || "?", me.avatar);
        const replyStatus = scoped(Object.assign(document.createElement("p"), { className: "atmo__status" }));
        replyStatus.setAttribute("role", "status");
        holder.append(form, replyStatus);
        (comment.querySelector("article") ?? comment).append(holder);
        const close = () => holder.remove();
        form.querySelector("[data-cancel-context]")!.addEventListener("click", close);
        setUpComposer(form, {
          extra: () => ({ parent: comment.dataset.atmosphereUri }),
          tell: (message) => (replyStatus.textContent = message),
          // The reply appears under the comment (the page adds it), so the box goes.
          onPosted: close,
        });
        holder.scrollIntoView({ block: "nearest", behavior: "smooth" });
        textarea.focus({ preventScroll: true });
      };
      const closeReplies = () => document.querySelectorAll(".atmo--inline").forEach((box) => box.remove());

      // Under every comment the page marks with its AT URI: Reply, and Like
      // and Repost with their counts, as in the Bluesky app.
      const HEART = '<path d="M12 20.5s-7.5-4.4-7.5-10.1A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8c0 5.7-7.5 10.1-7.5 10.1Z" />';
      const ARROWS = '<path d="M7 8h10l-3-3M17 16H7l3 3M5 13V9.5A1.5 1.5 0 0 1 6.5 8M19 11v3.5a1.5 1.5 0 0 1-1.5 1.5" />';
      const signInFirst = (message: string) => {
        this.scrollIntoView({ block: "center", behavior: "smooth" });
        say(message);
        openLogin();
      };

      // What the reader has liked or reposted, by post (filled in by loadState).
      let known: Record<string, { liked: boolean; reposted: boolean }> = {};

      const commentButton = (kind: "like" | "repost", comment: HTMLElement) => {
        const button = Object.assign(document.createElement("button"), { type: "button", className: "atmo-comment-action" });
        button.dataset.kind = kind;
        const seen = known[comment.dataset.atmosphereUri!];
        button.setAttribute("aria-pressed", String(!!(kind === "like" ? seen?.liked : seen?.reposted)));
        const author = comment.dataset.atmosphereAuthor || "this comment";
        button.setAttribute("aria-label", `${kind === "like" ? "Like" : "Repost"} ${author}'s comment`);
        const count = Number(comment.dataset[kind === "like" ? "atmosphereLikes" : "atmosphereReposts"] || 0);
        button.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${kind === "like" ? HEART : ARROWS}</svg><span></span>`;
        const setCount = (value: number) => {
          button.dataset.count = String(value);
          button.querySelector("span")!.textContent = value ? String(value) : "";
        };
        setCount(count);
        button.addEventListener("click", async () => {
          if (!isSignedIn) return signInFirst(`Sign in to ${kind} comments.`);
          const on = button.getAttribute("aria-pressed") !== "true";
          const before = Number(button.dataset.count || 0);
          button.setAttribute("aria-pressed", String(on));
          setCount(Math.max(0, before + (on ? 1 : -1)));
          try {
            const response = await send("react", { post: comment.dataset.atmosphereUri, kind, on });
            if (!response.ok) throw await response.json();
          } catch (problem) {
            button.setAttribute("aria-pressed", String(!on));
            setCount(before);
            handleError((problem as { error?: string })?.error ?? "error");
          }
        });
        return button;
      };

      // Returns how many comments got buttons, so new arrivals can be checked.
      const addCommentActions = (): number => {
        let added = 0;
        document.querySelectorAll<HTMLElement>("[data-atmosphere-uri]").forEach((comment) => {
          if (comment.querySelector(":scope .atmo-comment-actions")) return;
          added += 1;
          const actions = Object.assign(document.createElement("div"), { className: "atmo-comment-actions" });
          const author = comment.dataset.atmosphereAuthor || "this comment";
          const reply = Object.assign(document.createElement("button"), {
            type: "button",
            className: "atmo-comment-action",
            textContent: "Reply",
          });
          reply.setAttribute("aria-label", `Reply to ${author}`);
          reply.addEventListener("click", () => {
            if (!isSignedIn) return signInFirst("Sign in to reply.");
            openReply(comment, author);
          });
          actions.append(reply, commentButton("like", comment), commentButton("repost", comment));
          (comment.querySelector("article") ?? comment).append(actions);
        });
        return added;
      };

      // Which of the post and its comments the reader has already liked or reposted.
      const loadState = async () => {
        if (!post) return;
        const comments = [...document.querySelectorAll<HTMLElement>("[data-atmosphere-uri]")];
        const uris = [post, ...comments.map((comment) => comment.dataset.atmosphereUri!)];
        try {
          const query = uris.map((uri) => `post=${encodeURIComponent(uri)}`).join("&");
          const response = await fetch(`${base}/state?${query}`, { credentials: "same-origin" });
          const state = (await response.json()) as {
            error?: string;
            posts?: Record<string, { liked: boolean; reposted: boolean }>;
          };
          if (!response.ok) return handleError(state.error ?? "error");
          const posts = state.posts ?? {};
          known = { ...known, ...posts };
          setPressed("like", !!posts[post]?.liked);
          setPressed("repost", !!posts[post]?.reposted);
          for (const comment of comments) {
            const seen = posts[comment.dataset.atmosphereUri!];
            if (!seen) continue;
            comment.querySelector(".atmo-comment-action[data-kind='like']")?.setAttribute("aria-pressed", String(seen.liked));
            comment.querySelector(".atmo-comment-action[data-kind='repost']")?.setAttribute("aria-pressed", String(seen.reposted));
          }
        } catch {
          // The buttons stay as they are; a click still works.
        }
      };

      const show = async (signed: boolean, handle?: string, displayName?: string, avatar?: string) => {
        if (handle) {
          $<HTMLElement>("[data-preview-name]").textContent = displayName || handle;
          $<HTMLElement>("[data-preview-handle]").textContent = `@${handle}`;
          setAvatar($<HTMLElement>("[data-preview-avatar]"), displayName || handle, avatar);
          setAvatar($<HTMLElement>("[data-me-avatar]"), displayName || handle, avatar);
          $<HTMLElement>("[data-handle]").textContent = `@${handle}`;
        }
        await threadReady;
        if (this.classList.contains("is-inactive")) return;
        isSignedIn = signed;
        signedOut.hidden = signed;
        signedIn.hidden = !signed;
        if (!signed) return closeReplies();
        addCommentActions();
        await loadState();
      };

      // A message from the sign-in round trip (?atmosphere=…), then tidy the address.
      const url = new URL(location.href);
      const result = url.searchParams.get("atmosphere");
      if (result) {
        say(MESSAGES[result] ?? "");
        url.searchParams.delete("atmosphere");
        history.replaceState(history.state, "", url);
      }

      this.classList.add("is-loading");
      fetch(`${base}/me`, { credentials: "same-origin" })
        .then((response) => response.json())
        .then((found: { signedIn: boolean; did?: string; handle?: string; displayName?: string; avatar?: string }) => {
          me = found;
          return show(found.signedIn, found.handle, found.displayName, found.avatar);
        })
        .catch(() => show(false))
        .finally(() => {
          this.classList.remove("is-loading");
          addCommentActions();
        });
      // Comments arrive later (they're loaded separately), so look again then,
      // and check what a signed-in reader has liked among the new ones.
      let recheck: number | undefined;
      new MutationObserver(() => {
        if (!addCommentActions() || !isSignedIn) return;
        window.clearTimeout(recheck);
        recheck = window.setTimeout(loadState, 300);
      }).observe(document.body, { childList: true, subtree: true });

      // Like and Repost: shown as done straight away, put back if it fails.
      const reactButton = (kind: string) => $<HTMLButtonElement>(`[data-react='${kind}']`);
      const setPressed = (kind: string, on: boolean) => reactButton(kind).setAttribute("aria-pressed", String(on));
      for (const kind of ["like", "repost"]) {
        reactButton(kind).addEventListener("click", async () => {
          const on = reactButton(kind).getAttribute("aria-pressed") !== "true";
          setPressed(kind, on);
          try {
            const response = await send("react", { post, kind, on });
            if (!response.ok) {
              setPressed(kind, !on);
              return handleError((await response.json()).error);
            }
            say(on ? (kind === "like" ? "Liked." : "Reposted.") : kind === "like" ? "Like removed." : "Repost removed.");
            showReaction(kind, on);
            this.dispatchEvent(
              new CustomEvent("atmosphere:reacted", {
                detail: { kind, on, author: { did: me.did, handle: me.handle, displayName: me.displayName, avatar: me.avatar } },
                bubbles: true,
              }),
            );
          } catch {
            setPressed(kind, !on);
            say(MESSAGES.error);
          }
        });
      }

      $<HTMLButtonElement>("[data-sign-out]").addEventListener("click", async () => {
        await fetch(`${base}/logout`, { method: "POST", credentials: "same-origin" }).catch(() => undefined);
        void show(false);
        setMainMode("comment");
        say("You're signed out.");
      });
    }
  }

  customElements.define("atmosphere-comments", AtmosphereComments);
</script>

