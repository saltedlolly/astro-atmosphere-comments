---
// Under a post: Like, Repost and Quote buttons and a box to write a comment (a
// reply to the post's announcement, or to one of its comments). Signed out,
// they open an overlay to sign in with an Atmosphere account (Bluesky or any
// other), and what the reader pressed is finished once they're back.
//
// Props:
//   post   the announcement's AT URI (at://did/app.bsky.feed.post/rkey).
//   label   the sign-in overlay's heading when commenting (default "Sign in to leave a comment").
//   blueskyLink  "Rather not sign in here? Reply on Bluesky instead →" in the
//           sign-in overlay (default true; false hides it).
//   credit  a small "Powered by Atmosphere Comments for Astro" link under the
//           comments (default true; false hides it).
//
// Quote shows a preview of the reader's post with the announcement quoted
// inside, avatars and link-card picture included (passed on by this site).
//
// Typing @ and the start of a handle suggests accounts to mention, and typing
// in the sign-in box suggests matching accounts to sign in with.
//
// Comments: under every element on the page with a `data-atmosphere-uri`
// attribute (a comment's AT URI) the component adds Reply, Like and Repost.
// `data-atmosphere-author` names who wrote it, and `data-atmosphere-likes` /
// `data-atmosphere-reposts` give its counts.
//
// Colours come from CSS custom properties with sensible defaults, so a site
// can match its own theme: --atmo-text, --atmo-muted, --atmo-accent,
// --atmo-on-accent, --atmo-border, --atmo-field-bg, --atmo-radius.
//
// After posting, the element fires `atmosphere:commented` (detail: { uri, url,
// text, author, createdAt, quote, parent }), and after a like or repost (or
// undoing one) `atmosphere:reacted` (detail: { kind, on, author }), so a site
// can show it straight away.
//
// With the integration's `standardSite` option, Like on the post also
// recommends the page's Standard.site record (<link rel="site.standard.document">),
// and un-liking removes the recommend. Likes on comments stay Bluesky likes.
import settings from "../lib/settings";
import SignInForm from "./SignInForm.astro";
import Composer from "./Composer.astro";
import "./atmosphere.css";
import { messagesFor, pickLocale, translate, translateHtml } from "../lib/i18n";
import { escapeHtml } from "../lib/translate";
import logo from "../assets/union.svg?url";

interface Props {
  /**
   * The post's announcement on Bluesky: its AT URI or bsky.app address. If
   * left out, the page's Standard.site record (<link rel="site.standard.document">)
   * is used to find it.
   */
  post?: string;
  /** The sign-in overlay's heading when commenting. */
  label?: string;
  /** The badge on comments by the site's own accounts. */
  authorLabel?: string;
  /** A small "Powered by Atmosphere Comments for Astro" link under the comments. Default true. */
  credit?: boolean;
  /** "Rather not sign in here? Reply on Bluesky instead →" in the sign-in overlay. Default true. */
  blueskyLink?: boolean;
  /** The language of the wording, e.g. "fr". Overrides the integration's `locale`. */
  locale?: string;
  /** Your own wording for any line, by its key in locales/en.json. */
  messages?: Record<string, string>;
}

const { post = "", label, authorLabel, credit = true, blueskyLink = true } = Astro.props;
// The wording: the language asked for (or Astro's i18n locale for the page),
// with the site's own lines on top. The script gets the same, as JSON.
const lang = pickLocale(Astro.props.locale, settings.locale, Astro.currentLocale);
const messages = messagesFor(lang, {
  ...settings.messages,
  ...Astro.props.messages,
  ...(label && { "signIn.heading": label }),
  ...(authorLabel && { "comment.author": authorLabel }),
});
const t = (key: string, vars?: Record<string, string | number>) => translate(messages, lang, key, vars);
const th = (key: string, html: Record<string, string>) => translateHtml(messages, lang, key, html);
// Links lead off the page, so they open in a new tab.
const link = (href: string | undefined, text: string, attributes = "") =>
  `<a${href ? ` href="${escapeHtml(href)}"` : ""} target="_blank" rel="noopener"${attributes}>${escapeHtml(text)}</a>`;
// The announcement on bsky.app, when the page is given it (otherwise the
// script fills it in once the thread has loaded).
const atUri = post.match(/^at:\/\/([^/]+)\/app\.bsky\.feed\.post\/([^/]+)$/);
const blueskyUrl = atUri
  ? `https://bsky.app/profile/${atUri[1]}/post/${atUri[2]}`
  : /^https:\/\/bsky\.app\/profile\/[^/]+\/post\/[^/]+$/.test(post)
    ? post
    : "";
const CREDIT_URL = "https://saltedlolly.com/atmosphere-comments-for-astro/";
const { base } = settings;
const returnTo = `${Astro.url.pathname}#atmosphere-comments`;
---

<atmosphere-comments class="atmo" id="atmosphere-comments" data-post={post} data-base={base} data-locale={lang} data-messages={JSON.stringify(messages)}>
  <div class="atmo-reactions" data-reactions data-pagefind-ignore hidden></div>

  {/* For everyone: signed out, these open the sign-in overlay below, and what was pressed is finished on coming back. */}
  <div class="atmo__signed-in" data-view="main" data-pagefind-ignore hidden>
    <div class="atmo__actions" role="group" aria-label={t("actions.label")}>
      <button type="button" class="atmo__action" data-react="like" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.4-7.5-10.1A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8c0 5.7-7.5 10.1-7.5 10.1Z" /></svg>
        <span data-label-off>{t("actions.like")}</span><span data-label-on>{t("actions.liked")}</span>
      </button>
      <button type="button" class="atmo__action" data-react="repost" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h10l-3-3M17 16H7l3 3M5 13V9.5A1.5 1.5 0 0 1 6.5 8M19 11v3.5a1.5 1.5 0 0 1-1.5 1.5" /></svg>
        <span data-label-off>{t("actions.repost")}</span><span data-label-on>{t("actions.reposted")}</span>
      </button>
      <button type="button" class="atmo__action" data-quote>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 18h5v-5H6.5A4.5 4.5 0 0 1 11 8.5V7a6 6 0 0 0-6 6Zm9 0h5v-5h-3.5A4.5 4.5 0 0 1 20 8.5V7a6 6 0 0 0-6 6Z" /></svg>
        <span>{t("actions.quote")}</span>
      </button>
      {/* With the `standardSite` option. */}
        {settings.standardSite && (
      <div class="atmo-subscribe" data-subscribe-panel data-pagefind-ignore hidden>
        <button type="button" class="atmo__action atmo-subscribe__button" data-atmosphere-subscribe hidden>
          <span class="atmo-subscribe__logo" style={`--atmo-logo: url("${logo}")`} aria-hidden="true"></span>
          <span data-atmosphere-subscribe-label>{t("subscribe.subscribe")}</span>
        </button>
        <button type="button" class="atmo__action atmo-subscribe__more" aria-label={t("subscribe.more")} title={t("subscribe.more")} aria-expanded="false" data-subscribe-more>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div class="atmo-subscribe__menu" data-subscribe-menu hidden>
          <p
            class="atmo-subscribe__note"
            set:html={th("subscribe.panelText", {
              leaflet: link("https://leaflet.pub", "Leaflet"),
              standardReader: link("https://standard-reader.app", "Standard Reader"),
            })}
          />
          <button type="button" data-subscribe-copy={settings.site} data-copied={t("subscribe.copied")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg><span data-copy-label>{t("subscribe.copyLink")}</span></button>
          {settings.standardSite.feed && <a href={settings.standardSite.feed}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" /><circle cx="6" cy="18" r="1" /></svg><span>{t("subscribe.feed")}</span></a>}
          <a href={blueskyUrl || undefined} hidden={!blueskyUrl} data-subscribe-bluesky target="_blank" rel="noopener"><svg class="atmo-subscribe__filled" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z" /></svg><span>{t("subscribe.viewBluesky")}</span></a>
          <a href={`https://standard-reader.app/p/${settings.standardSite.publication.split("/")[2]}/${settings.standardSite.publication.split("/")[4]}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" /></svg><span>{t("subscribe.standardReader")}</span></a>
        </div>
      </div>
    )}
    </div>

    {/* A sign-in from before posting was asked for: one more permission. */}
    <div class="atmo__permission" data-permission hidden>
      <p data-permission-text>{t("composer.needsPermission")}</p>
      <p class="atmo__hint">{t("permission.approve")}</p>
      <div class="atmo__row">
        <button type="button" class="atmo__button" data-permission-continue>{t("comment.continue")}</button>
        <button type="button" class="atmo__link-button" data-permission-sign-out>{t("composer.signOut")}</button>
      </div>
    </div>

    {/* Signed out: looks like the comment box, and opens the sign-in overlay. */}
    <div class="atmo__prompt-box" data-comment-prompt hidden>
      <button type="button" class="atmo__prompt" data-comment-prompt-open>{t("comment.prompt")}</button>
      <div class="atmo__row atmo__row--end">
        <button type="button" class="atmo__link-button" data-comment-prompt-open>{t("comment.signIn")}</button>
        <button type="button" class="atmo__button" disabled>{t("composer.postComment")}</button>
      </div>
    </div>

    <Composer id="atmo" messages={messages} lang={lang} signOut />
  </div>

  <dialog class="atmo atmo-signin" aria-label={t("signIn.heading")} data-signin-dialog data-pagefind-ignore>
    <button type="button" class="atmo-signin__close" aria-label={t("dialog.close")} data-close>×</button>
    <SignInForm id="atmo" returnTo={returnTo} messages={messages} lang={lang} />
    {blueskyLink && (
      <p
        class="atmo__elsewhere"
        data-elsewhere
        hidden={!blueskyUrl}
        set:html={th("elsewhere.text", {
          // u-syndication: microformats readers learn this is the post's copy on Bluesky.
          link: link(blueskyUrl || undefined, t("elsewhere.link"), ' class="atmo__elsewhere-link u-syndication" data-elsewhere-link'),
        })}
      />
    )}
    <p class="atmo-signin__status" role="status" data-dialog-status></p>
  </dialog>

  <p class="atmo__status" data-status role="status" data-pagefind-ignore></p>

  {/* Anything the site wants between the comment box and the comments. */}
  <slot name="after-box" />

  <ol class="atmo-comments" data-replies data-pagefind-ignore></ol>

  {/* Anything the site wants after the comments (other responses, say). */}
  <slot />

  {credit && (
    <p class="atmo__credit" data-credit data-pagefind-ignore set:html={th("credit", { link: link(CREDIT_URL, "Atmosphere Comments for Astro") })} />
  )}
</atmosphere-comments>

<script>
  import { translate } from "../lib/translate";
  import { enhanceHandleBox } from "../lib/client/handle-suggestions";
  import { MAX, quotePreview, setUpComposer, type ComposerBehaviour, type Posted } from "../lib/client/composer";
  import { handleSignInForm, me as whoIsSignedIn, send, signIn, signOut, state } from "../lib/client/account";
  import { addSubscribeButtons, finishPendingSubscribe, forgetSubscribed, loadSubscribed } from "../lib/client/subscribe";
  import type { Permission } from "../lib/permissions";
  import { authorOf } from "../lib/uris";


  // The error and status codes the routes and the sign-in round trip send,
  // and the wording for each (in locales/*.json).
  const MESSAGE_KEYS: Record<string, string> = {
    "signed-in": "messages.signedIn",
    "sign-in-failed": "messages.signInFailed",
    "account-not-found": "messages.accountNotFound",
    "invalid-handle": "messages.invalidHandle",
    "signed-out": "messages.signedOut",
    "needs-permission": "messages.needsPermission",
    "not-allowed": "messages.notAllowed",
    "too-long": "messages.tooLong",
    "too-many": "messages.tooMany",
    error: "messages.error",
  };


  class AtmosphereComments extends HTMLElement {
    connectedCallback() {
      const base = this.dataset.base ?? "/atmosphere";
      // The wording, in the page's language, from the server.
      const lang = this.dataset.locale || "en";
      const wording = JSON.parse(this.dataset.messages || "{}") as Record<string, string>;
      const t = (key: string, vars?: Record<string, string | number>) => translate(wording, lang, key, vars);
      const message = (code: string) => t(MESSAGE_KEYS[code] ?? MESSAGE_KEYS.error, { max: MAX });
      // The announcement's AT URI. A bsky.app address or the page's
      // Standard.site record is turned into one when the thread loads.
      let post = this.dataset.post?.startsWith("at://") ? this.dataset.post : "";
      const $ = <T extends Element>(selector: string) => this.querySelector<T>(selector)!;
      const commentPrompt = $<HTMLElement>("[data-comment-prompt]");
      const composer = $<HTMLFormElement>("[data-composer]");
      const permissionPanel = $<HTMLElement>("[data-permission]");
      // A clean copy of the comment box, for reply boxes under comments.
      const template = composer.cloneNode(true) as HTMLFormElement;
      const loginForm = $<HTMLFormElement>("[data-login-form]");
      const status = $<HTMLElement>("[data-status]");
      let isSignedIn = false;
      let me: { did?: string; handle?: string; displayName?: string; avatar?: string; can?: string[] } = {};
      const can = (permission: Permission) => !!me.can?.includes(permission);
      // What the main box is doing: a comment on the post, or a quote post.
      let mainMode: "comment" | "quote" = "comment";

      const say = (message: string) => (status.textContent = message);
      // Sends the reader to their account host for one more permission,
      // coming back to `hash` on this page (to finish what they asked).
      const askPermission = (permission: Permission, hash = "#atmosphere-comments") =>
        signIn(me.did!, { permissions: [permission], returnTo: `${location.pathname}${location.search}${hash}`, lang });
      // Says what the permission is for before going (the account host may
      // ask the reader to sign in again first, which is puzzling unexplained),
      // with Continue to approve. Delete and Hide do the same in their panels.
      const explainPermission = (permission: "post" | "react") => {
        const go = Object.assign(make("button", "atmo__link-button", t("comment.continue")), { type: "button" });
        go.addEventListener("click", () => void askPermission(permission));
        status.replaceChildren(`${t(`permission.${permission}`)} ${t("permission.approve")} `, go);
        status.scrollIntoView({ block: "nearest", behavior: "smooth" });
        go.focus({ preventScroll: true });
      };
      // Elements this script creates get the component's marker attribute, so
      // Astro's scoped styles still reach them.
      const scoped = <T extends HTMLElement>(element: T): T => {
        for (const { name, value } of this.attributes) {
          if (name.startsWith("data-astro-cid")) element.setAttribute(name, value);
        }
        return element;
      };

      // The thread: likes and reposts above the comment box, and the comments
      // below it, read through this site (routes/thread.ts).
      type Person = { did: string; handle: string; displayName?: string; avatar?: string; url: string };
      type Reply = {
        uri: string;
        url: string;
        author: Person;
        byAuthor: boolean;
        createdAt: string;
        text: { text: string; href: string | null }[];
        depth: number;
        likeCount: number;
        repostCount: number;
        withheld?: true;
      };
      type Thread = { uri: string; url: string; likeCount: number; repostCount: number; likes: Person[]; reposts: Person[]; replies: Reply[] };
      let thread: Thread | null = null;
      const reactionsBox = $<HTMLElement>("[data-reactions]");
      const repliesList = $<HTMLOListElement>("[data-replies]");
      const authorLabel = t("comment.author");
      const nameOf = (person: Pick<Person, "handle" | "displayName">) => person.displayName || `@${person.handle}`;
      const dates = new Intl.DateTimeFormat(lang, {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
      const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text?: string) => {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      };
      const avatarOf = (person: Pick<Person, "handle" | "displayName" | "avatar">, className: string) => {
        if (person.avatar) return Object.assign(make("img", className), { src: person.avatar, alt: "", loading: "lazy" as const });
        const initial = make("span", `${className} atmo-avatar-initial`, nameOf(person).replace("@", "").charAt(0).toUpperCase());
        initial.setAttribute("aria-hidden", "true");
        return initial;
      };

      const renderReactions = () => {
        if (!thread) return;
        const groups = [
          { kind: "like", count: thread.likeCount, people: thread.likes },
          { kind: "repost", count: thread.repostCount, people: thread.reposts },
        ].filter((group) => group.count > 0);
        reactionsBox.hidden = !groups.length;
        reactionsBox.replaceChildren(
          ...groups.map(({ kind, count, people }) => {
            const group = make("div", "atmo-reactions__group");
            group.dataset.reaction = kind;
            group.append(make("p", "atmo-reactions__count", t(kind === "like" ? "reactions.likes" : "reactions.reposts", { count })));
            const faces = make("ul", "atmo-facepile");
            for (const person of people) {
              const link = Object.assign(make("a"), { href: person.url, title: nameOf(person), rel: "ugc nofollow noopener", target: "_blank" });
              link.setAttribute("aria-label", nameOf(person));
              link.append(avatarOf(person, "atmo-facepile__avatar"));
              const item = make("li");
              item.append(link);
              faces.append(item);
            }
            if (count > people.length) faces.append(Object.assign(make("li"), { className: "atmo-facepile__more", textContent: `+${count - people.length}` }));
            group.append(faces);
            return group;
          }),
        );
      };

      const replyElement = (reply: Reply) => {
        const item = make("li", `atmo-comment${reply.byAuthor ? " atmo-comment--author" : ""}${reply.depth ? " atmo-comment--nested" : ""}`);
        if (reply.depth) item.style.setProperty("--depth", String(Math.min(reply.depth, 3)));
        // Its author asks not to be shown to logged-out people: a placeholder,
        // keeping the replies under it in place. (No AT URI, so no actions.)
        if (reply.withheld) {
          item.classList.add("atmo-comment--withheld");
          const article = make("article");
          article.append(make("p", "atmo-comment__withheld", t("comment.withheld")));
          item.append(article);
          return item;
        }
        item.dataset.atmosphereUri = reply.uri;
        item.dataset.atmosphereUrl = reply.url;
        item.dataset.atmosphereAuthor = nameOf(reply.author);
        item.dataset.atmosphereLikes = String(reply.likeCount);
        item.dataset.atmosphereReposts = String(reply.repostCount);
        const author = Object.assign(make("a", "atmo-comment__author", nameOf(reply.author)), {
          href: reply.author.url,
          rel: "ugc nofollow noopener",
          target: "_blank",
        });
        const who = make("div", "atmo-comment__who");
        who.append(author);
        if (reply.byAuthor) who.append(make("span", "atmo-comment__badge", authorLabel));
        const date = Object.assign(make("a", "atmo-comment__date"), { href: reply.url, rel: "ugc nofollow noopener", target: "_blank" });
        const time = Object.assign(make("time"), { dateTime: reply.createdAt, textContent: reply.createdAt ? dates.format(new Date(reply.createdAt)) : "" });
        date.append(time, make("span", "", ` · ${t("comment.viewOnBluesky")}`));
        const names = make("div");
        names.append(who, date);
        const header = make("header", "atmo-comment__header");
        header.append(avatarOf(reply.author, "atmo-comment__avatar"), names);
        const body = make("div", "atmo-comment__body");
        const paragraph = make("p");
        for (const piece of reply.text) {
          paragraph.append(
            piece.href ? Object.assign(make("a", "", piece.text), { href: piece.href, rel: "ugc nofollow noopener", target: "_blank" }) : piece.text,
          );
        }
        body.append(paragraph);
        const article = make("article");
        article.append(header, body);
        item.append(article);
        return item;
      };

      // Finds the announcement (given, or from the page's Standard.site record)
      // and shows its thread. Without one there is nothing to respond to.
      // Nothing to respond to: hide the box and likes, but keep whatever the
      // site put in the slots.
      const deactivate = () => {
        for (const part of this.querySelectorAll<HTMLElement>("[data-view], [data-reactions], [data-replies], [data-credit], [data-subscribe-panel]")) {
          part.hidden = true;
        }
        this.classList.add("is-inactive");
      };
      const loadThread = async () => {
        const given = this.dataset.post ?? "";
        const record = document.querySelector('link[rel="site.standard.document"]')?.getAttribute("href") ?? "";
        const query = given ? `post=${encodeURIComponent(given)}` : record ? `document=${encodeURIComponent(record)}` : "";
        if (!query) {
          deactivate();
          return;
        }
        try {
          const response = await fetch(`${base}/thread?${query}`);
          const data = (await response.json()) as { thread?: Thread | null };
          if (!data.thread) {
            if (!post) deactivate();
            return;
          }
          thread = data.thread;
          post = thread.uri;
          const viewOnBluesky = this.querySelector<HTMLAnchorElement>("[data-subscribe-bluesky]");
          if (viewOnBluesky && thread.url) {
            viewOnBluesky.href = thread.url;
            viewOnBluesky.hidden = false;
          }
          const elsewhere = this.querySelector<HTMLElement>("[data-elsewhere]");
          if (elsewhere && thread.url) {
            elsewhere.querySelector("a")!.href = thread.url;
            elsewhere.hidden = false;
          }
          renderReactions();
          repliesList.replaceChildren(...thread.replies.map(replyElement));
        } catch {
          // Without the thread the box still works if the post was given.
          if (!post) deactivate();
        }
      };
      const threadReady = loadThread();

      // A comment just posted, shown at once (Bluesky takes a moment to list it).
      const showPosted = (data: Posted) => {
        if (data.quote) return;
        const parent = data.parent
          ? repliesList.querySelector<HTMLElement>(`[data-atmosphere-uri="${CSS.escape(data.parent)}"]`)
          : null;
        const depth = parent ? Number(parent.style.getPropertyValue("--depth") || 0) + 1 : 0;
        const item = replyElement({
          uri: data.uri,
          url: data.url,
          author: { ...data.author, url: `https://bsky.app/profile/${encodeURIComponent(data.author.handle)}` },
          byAuthor: false,
          createdAt: data.createdAt,
          text: [{ text: data.text, href: null }],
          depth,
          likeCount: 0,
          repostCount: 0,
        });
        if (parent) parent.after(item);
        else repliesList.append(item);
        item.scrollIntoView({ block: "nearest", behavior: "smooth" });
      };

      // A like or repost of the post, shown at once among the faces.
      const showReaction = (kind: string, on: boolean) => {
        if (!thread || !me.did || !me.handle) return;
        const people = kind === "like" ? thread.likes : thread.reposts;
        const index = people.findIndex((person) => person.did === me.did);
        if (on === index >= 0) return;
        if (on) people.unshift({ did: me.did, handle: me.handle, displayName: me.displayName, avatar: me.avatar, url: `https://bsky.app/profile/${encodeURIComponent(me.handle)}` });
        else people.splice(index, 1);
        if (kind === "like") thread.likeCount = Math.max(0, thread.likeCount + (on ? 1 : -1));
        else thread.repostCount = Math.max(0, thread.repostCount + (on ? 1 : -1));
        renderReactions();
      };

      // The sign-in overlay: for whatever a signed-out reader pressed. They come
      // back to `hash` on this page, and it's finished then (resumePending).
      const signInDialog = $<HTMLDialogElement>("[data-signin-dialog]");
      const dialogHeading = loginForm.querySelector("label")!;
      const dialogStatus = $<HTMLElement>("[data-dialog-status]");
      const openSignIn = (heading: string, hash: string, problem = "") => {
        dialogHeading.textContent = heading;
        signInDialog.setAttribute("aria-label", heading);
        loginForm.querySelector<HTMLInputElement>("[data-return-to]")!.value = `${location.pathname}${location.search}${hash}`;
        dialogStatus.textContent = problem;
        if (!signInDialog.open) signInDialog.showModal();
        loginForm.querySelector<HTMLInputElement>('input[name="handle"]')!.focus();
      };
      signInDialog.querySelector("[data-close]")!.addEventListener("click", () => signInDialog.close());
      // A click on the dimmed page around the overlay closes it.
      signInDialog.addEventListener("click", (event) => {
        if (event.target === signInDialog) signInDialog.close();
      });
      const SIGN_IN_HEADINGS: Record<string, string> = {
        like: "signInFirst.likePost",
        repost: "signInFirst.repostPost",
        quote: "signInFirst.quotePost",
        comment: "signIn.heading",
        reply: "signInFirst.reply",
        "comment-like": "signInFirst.like",
        "comment-repost": "signInFirst.repost",
      };
      const askToSignIn = (kind: string, uri?: string, problem?: string) =>
        openSignIn(t(SIGN_IN_HEADINGS[kind]), `#atmo-do=${kind}${uri ? `:${encodeURIComponent(uri)}` : ""}`, problem);
      commentPrompt.querySelectorAll("[data-comment-prompt-open]").forEach((opener) => opener.addEventListener("click", () => askToSignIn("comment")));

      enhanceHandleBox(loginForm, base);
      handleSignInForm(loginForm, lang);

      // An avatar picture, or the name's first letter if there isn't one.
      const setAvatar = (slot: HTMLElement, name: string, src?: string) => {
        slot.replaceChildren();
        slot.textContent = name.trim().charAt(0).toUpperCase();
        if (!src) return;
        const img = Object.assign(document.createElement("img"), { src, alt: "" });
        img.onload = () => slot.replaceChildren(img);
      };

      const handleError = (error: string, tell: (message: string) => void = say, permission?: string) => {
        if (error === "signed-out") void show(false);
        // The page checks before it starts, so this is rare: ask now.
        if (error === "needs-permission" && (permission === "post" || permission === "react")) return explainPermission(permission);
        tell(message(error));
      };

      const postedMessage = (where: HTMLElement, data: Posted) =>
        where.replaceChildren(
          `${t(data.quote ? "posted.quote" : "posted.comment")} `,
          Object.assign(document.createElement("a"), { href: data.url, textContent: t("posted.see"), target: "_blank", rel: "noopener noreferrer" }),
        );

      // The comment box (lib/client/composer.ts): posts as a reply to the
      // announcement, then shows it straight away and tells the page.
      const composerContext = { base, t, message, setAvatar };
      const composerFor = (
        form: HTMLFormElement,
        behaviour: Omit<ComposerBehaviour, "root" | "onError" | "onPosted"> & { onPosted: (data: Posted) => void },
      ) =>
        setUpComposer(form, composerContext, {
          ...behaviour,
          root: () => post,
          onError: handleError,
          onPosted: (data) => {
            behaviour.onPosted(data);
            showPosted(data);
            this.dispatchEvent(new CustomEvent("atmosphere:commented", { detail: data, bubbles: true }));
          },
        });

      // The Quote preview (lib/client/composer.ts).
      const preview = $<HTMLElement>("[data-preview]");

      // The main box: a comment on the post, or (after Quote) a quote post.
      const setMainMode = (next: "comment" | "quote") => {
        mainMode = next;
        const quoting = next === "quote";
        $<HTMLElement>("[data-context]").hidden = !quoting;
        $<HTMLElement>("[data-context-text]").textContent = quoting ? t("composer.quoting") : "";
        $<HTMLElement>("[data-verb]").textContent = t(quoting ? "composer.quote" : "composer.comment");
        $<HTMLElement>("[data-submit]").textContent = t(quoting ? "composer.postQuote" : "composer.postComment");
        preview.hidden = !quoting;
        if (quoting) void quote.load(post);
      };
      const main = composerFor(composer, {
        extra: () => (mainMode === "quote" ? { quote: true } : {}),
        tell: say,
        onPosted: (data) => {
          setMainMode("comment");
          postedMessage(status, data);
        },
        onInput: () => quote.update(),
      });
      const quote = quotePreview(composer, main.textarea, composerContext);
      $<HTMLButtonElement>("[data-cancel-context]").addEventListener("click", () => {
        setMainMode("comment");
        main.textarea.focus();
      });
      $<HTMLButtonElement>("[data-quote]").addEventListener("click", () => {
        if (!isSignedIn) return askToSignIn("quote");
        if (!can("post")) return explainPermission("post");
        setMainMode("quote");
        main.textarea.focus();
      });

      // A reply box of its own under a comment, so the main box stays where
      // it is: the reader can comment on the post or reply to a comment.
      let replyBoxes = 0;
      const openReply = (comment: HTMLElement, author: string) => {
        const open = comment.querySelector<HTMLElement>(":scope > .atmo--inline, :scope article > .atmo--inline");
        if (open) return open.querySelector("textarea")?.focus();
        replyBoxes += 1;
        const id = `atmo-reply-${replyBoxes}`;
        const holder = scoped(Object.assign(document.createElement("div"), { className: "atmo atmo--inline" }));
        const form = template.cloneNode(true) as HTMLFormElement;
        form.querySelector("[data-preview]")?.remove();
        form.querySelector("[data-sign-out]")?.remove();
        const textarea = form.querySelector("textarea")!;
        const suggestions = form.querySelector<HTMLElement>("[data-suggestions]")!;
        textarea.id = `${id}-text`;
        form.querySelector("label")?.setAttribute("for", textarea.id);
        suggestions.id = `${id}-suggestions`;
        textarea.setAttribute("aria-controls", suggestions.id);
        form.querySelector<HTMLElement>("[data-context]")!.hidden = false;
        form.querySelector("[data-context-text]")!.textContent = t("composer.replyingTo", { name: author });
        form.querySelector("[data-verb]")!.textContent = t("comment.reply");
        form.querySelector("[data-submit]")!.textContent = t("composer.postReply");
        form.querySelector("[data-handle]")!.textContent = me.handle ? `@${me.handle}` : "";
        setAvatar(form.querySelector<HTMLElement>("[data-me-avatar]")!, me.displayName || me.handle || "?", me.avatar);
        const replyStatus = scoped(Object.assign(document.createElement("p"), { className: "atmo__status" }));
        replyStatus.setAttribute("role", "status");
        holder.append(form, replyStatus);
        (comment.querySelector("article") ?? comment).append(holder);
        const close = () => holder.remove();
        form.querySelector("[data-cancel-context]")!.addEventListener("click", close);
        composerFor(form, {
          extra: () => ({ parent: comment.dataset.atmosphereUri }),
          tell: (message) => (replyStatus.textContent = message),
          // The reply appears under the comment (the page adds it), so the box goes.
          onPosted: close,
        });
        holder.scrollIntoView({ block: "nearest", behavior: "smooth" });
        textarea.focus({ preventScroll: true });
      };
      const closeReplies = () => document.querySelectorAll(".atmo--inline").forEach((box) => box.remove());

      // Under every comment the page marks with its AT URI: Reply, and Like
      // and Repost with their counts, as in the Bluesky app.
      const HEART = '<path d="M12 20.5s-7.5-4.4-7.5-10.1A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8c0 5.7-7.5 10.1-7.5 10.1Z" />';
      const ARROWS = '<path d="M7 8h10l-3-3M17 16H7l3 3M5 13V9.5A1.5 1.5 0 0 1 6.5 8M19 11v3.5a1.5 1.5 0 0 1-1.5 1.5" />';

      // Subscribe: not signed in, the overlay, coming back to subscribe.
      const subscribePanel = this.querySelector<HTMLElement>("[data-subscribe-panel]");
      const askToSubscribe = (problem?: string) => openSignIn(t("subscribe.signIn"), "#atmo-subscribe", problem);
      if (subscribePanel) addSubscribeButtons([...subscribePanel.querySelectorAll<HTMLButtonElement>("[data-atmosphere-subscribe]")], t, askToSubscribe);

      // The ⌄ menu beside Subscribe: more ways to follow the site.
      const moreButton = subscribePanel?.querySelector<HTMLButtonElement>("[data-subscribe-more]");
      const moreMenu = subscribePanel?.querySelector<HTMLElement>("[data-subscribe-menu]");
      if (subscribePanel && moreButton && moreMenu) {
        const setMenu = (open: boolean) => {
          moreMenu.hidden = !open;
          moreButton.setAttribute("aria-expanded", String(open));
        };
        moreButton.addEventListener("click", () => {
          setMenu(moreMenu.hidden);
          if (!moreMenu.hidden) moreMenu.querySelector<HTMLElement>("[data-subscribe-copy]")?.focus();
        });
        document.addEventListener("click", (event) => {
          if (!subscribePanel.contains(event.target as Node)) setMenu(false);
        });
        subscribePanel.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !moreMenu.hidden) {
            setMenu(false);
            moreButton.focus();
          }
        });
        const copy = moreMenu.querySelector<HTMLButtonElement>("[data-subscribe-copy]")!;
        const copyText = copy.querySelector<HTMLElement>("[data-copy-label]")!;
        const copyLabel = copyText.textContent;
        copy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(copy.dataset.subscribeCopy!);
            copyText.textContent = copy.dataset.copied!;
            window.setTimeout(() => {
              copyText.textContent = copyLabel;
              setMenu(false);
            }, 1200);
          } catch {
            // Clipboard refused: the button stays as it was.
          }
        });
      }

      // What the reader has liked or reposted, by post (filled in by loadState).
      let known: Record<string, { liked: boolean; reposted: boolean }> = {};

      const commentButton = (kind: "like" | "repost", comment: HTMLElement) => {
        const button = Object.assign(document.createElement("button"), { type: "button", className: "atmo-comment-action" });
        button.dataset.kind = kind;
        const seen = known[comment.dataset.atmosphereUri!];
        button.setAttribute("aria-pressed", String(!!(kind === "like" ? seen?.liked : seen?.reposted)));
        const author = comment.dataset.atmosphereAuthor || t("comment.someone");
        button.setAttribute("aria-label", t(kind === "like" ? "comment.likeLabel" : "comment.repostLabel", { name: author }));
        const count = Number(comment.dataset[kind === "like" ? "atmosphereLikes" : "atmosphereReposts"] || 0);
        button.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${kind === "like" ? HEART : ARROWS}</svg><span></span>`;
        const setCount = (value: number) => {
          button.dataset.count = String(value);
          button.querySelector("span")!.textContent = value ? String(value) : "";
        };
        setCount(count);
        button.addEventListener("click", async () => {
          if (!isSignedIn) return askToSignIn(kind === "like" ? "comment-like" : "comment-repost", comment.dataset.atmosphereUri);
          const on = button.getAttribute("aria-pressed") !== "true";
          const before = Number(button.dataset.count || 0);
          button.setAttribute("aria-pressed", String(on));
          setCount(Math.max(0, before + (on ? 1 : -1)));
          try {
            const response = await send("react", { post: comment.dataset.atmosphereUri, kind, on });
            if (!response.ok) throw await response.json();
          } catch (problem) {
            button.setAttribute("aria-pressed", String(!on));
            setCount(before);
            const { error, permission } = (problem ?? {}) as { error?: string; permission?: string };
            handleError(error ?? "error", say, permission);
          }
        });
        return button;
      };

      // Returns how many comments got buttons, so new arrivals can be checked.
      const addCommentActions = (): number => {
        let added = 0;
        document.querySelectorAll<HTMLElement>("[data-atmosphere-uri]").forEach((comment) => {
          if (comment.querySelector(":scope .atmo-comment-actions")) return;
          added += 1;
          const actions = Object.assign(document.createElement("div"), { className: "atmo-comment-actions" });
          const author = comment.dataset.atmosphereAuthor || t("comment.someone");
          const reply = Object.assign(document.createElement("button"), {
            type: "button",
            className: "atmo-comment-action",
            textContent: t("comment.reply"),
          });
          reply.setAttribute("aria-label", t("comment.replyTo", { name: author }));
          reply.addEventListener("click", () => {
            if (!isSignedIn) return askToSignIn("reply", comment.dataset.atmosphereUri);
            if (!can("post")) return explainPermission("post");
            openReply(comment, author);
          });
          actions.append(reply, commentButton("like", comment), commentButton("repost", comment));
          (comment.querySelector("article") ?? comment).append(actions);
        });
        addDeleteButtons();
        return added;
      };

      // Delete, under the signed-in reader's own comments only.
      const isMine = (comment: HTMLElement) => !!me.did && !!comment.dataset.atmosphereUri?.startsWith(`at://${me.did}/`);

      const deleteComment = async (comment: HTMLElement, panel: HTMLElement) => {
        const uri = comment.dataset.atmosphereUri!;
        panel.replaceChildren(make("span", "atmo-comment-delete__text", t("comment.deleting")));
        try {
          const response = await send("delete", { post: uri });
          const data = (await response.json()) as { error?: string };
          if (response.ok) {
            comment.remove();
            say(t("comment.deleted"));
            this.dispatchEvent(new CustomEvent("atmosphere:deleted", { detail: { uri }, bubbles: true }));
            return;
          }
          // The page checks first, so this is rare: ask now.
          if (data.error === "needs-permission") return void askPermission("delete", `#atmo-delete=${encodeURIComponent(uri)}`);
          panel.remove();
          handleError(data.error ?? "error");
        } catch {
          panel.remove();
          say(message("error"));
        }
      };

      // Hide, for the announcement's own author: hides a comment here and on
      // Bluesky. Showing it again is done in the Bluesky app.
      const isOwner = () => !!me.did && !!post && authorOf(post) === me.did;

      const hideComment = async (comment: HTMLElement, panel: HTMLElement) => {
        const uri = comment.dataset.atmosphereUri!;
        panel.replaceChildren(make("span", "atmo-comment-delete__text", t("comment.hiding")));
        try {
          const response = await send("hide", { post: uri, root: post });
          const data = (await response.json()) as { error?: string };
          if (response.ok) {
            comment.remove();
            say(t("comment.hidden"));
            this.dispatchEvent(new CustomEvent("atmosphere:hidden", { detail: { uri }, bubbles: true }));
            return;
          }
          if (data.error === "needs-permission") return void askPermission("moderate", `#atmo-hide=${encodeURIComponent(uri)}`);
          panel.remove();
          handleError(data.error ?? "error");
        } catch {
          panel.remove();
          say(message("error"));
        }
      };

      // Delete and Hide each need one more permission than signing in gives.
      // Readers who haven't given it yet are asked for it first; once they
      // have (straight away, or back from approving), they confirm.
      const STEPS = {
        delete: {
          permission: "delete",
          action: "comment.delete",
          label: "comment.deleteLabel",
          confirm: "comment.deleteConfirm",
          needs: "comment.deletePermission",
          // "{{link}}" in the wording: the comment on Bluesky, to delete it there instead.
          elsewhere: "comment.deleteElsewhere",
          run: deleteComment,
        },
        hide: {
          permission: "moderate",
          action: "comment.hide",
          label: "comment.hideLabel",
          confirm: "comment.hideConfirm",
          needs: "comment.hidePermission",
          elsewhere: "",
          run: hideComment,
        },
      } as const;

      const openPanel = (comment: HTMLElement, kind: keyof typeof STEPS) => {
        const actions = comment.querySelector<HTMLElement>(":scope .atmo-comment-actions");
        if (!actions || actions.nextElementSibling?.matches(".atmo-comment-delete")) return;
        const step = STEPS[kind];
        const panel = make("div", "atmo-comment-delete");
        panel.setAttribute("role", "group");
        panel.setAttribute("aria-label", t(step.label));
        const button = (text: string, danger = false) =>
          Object.assign(make("button", `atmo-comment-action${danger ? " atmo-comment-action--danger" : ""}`, text), { type: "button" });
        const no = button(t("comment.cancel"));
        no.addEventListener("click", () => {
          panel.remove();
          actions.querySelector<HTMLElement>(`.atmo-comment-action--${kind}`)?.focus();
        });
        if (can(step.permission)) {
          const yes = button(t(step.action), true);
          yes.addEventListener("click", () => step.run(comment, panel));
          panel.append(make("span", "atmo-comment-delete__text", t(step.confirm)), yes, no);
          actions.after(panel);
          no.focus();
        } else {
          const go = button(t("comment.continue"), true);
          go.addEventListener("click", () =>
            void askPermission(step.permission, `#atmo-${kind}=${encodeURIComponent(comment.dataset.atmosphereUri!)}`),
          );
          const text = make("span", "atmo-comment-delete__text");
          const [before, after = ""] = t(step.needs, { link: "\u0000" }).split("\u0000");
          text.append(before);
          if (step.elsewhere) {
            const url = comment.dataset.atmosphereUrl;
            text.append(
              url
                ? Object.assign(make("a", "", t(step.elsewhere)), { href: url, target: "_blank", rel: "noopener noreferrer" })
                : t(step.elsewhere),
              after,
            );
          }
          panel.append(text, go, no);
          actions.after(panel);
          go.focus();
        }
      };

      const panelButton = (comment: HTMLElement, kind: keyof typeof STEPS) => {
        const button = Object.assign(make("button", `atmo-comment-action atmo-comment-action--${kind}`, t(STEPS[kind].action)), { type: "button" });
        button.setAttribute("aria-label", t(STEPS[kind].label));
        button.addEventListener("click", () => openPanel(comment, kind));
        return button;
      };

      const addDeleteButtons = () => {
        document.querySelectorAll<HTMLElement>("[data-atmosphere-uri]").forEach((comment) => {
          const actions = comment.querySelector<HTMLElement>(":scope .atmo-comment-actions");
          if (!actions || actions.querySelector(".atmo-comment-action--delete, .atmo-comment-action--hide")) return;
          if (isSignedIn && isMine(comment)) actions.append(panelButton(comment, "delete"));
          else if (isSignedIn && isOwner()) actions.append(panelButton(comment, "hide"));
        });
      };

      // Which of the post and its comments the reader has already liked or reposted.
      const loadState = async () => {
        if (!post) return;
        const comments = [...document.querySelectorAll<HTMLElement>("[data-atmosphere-uri]")];
        const uris = [post, ...comments.map((comment) => comment.dataset.atmosphereUri!)];
        try {
          const response = await state(uris);
          const found = (await response.json()) as {
            error?: string;
            posts?: Record<string, { liked: boolean; reposted: boolean }>;
          };
          if (!response.ok) return handleError(found.error ?? "error");
          const posts = found.posts ?? {};
          known = { ...known, ...posts };
          setPressed("like", !!posts[post]?.liked);
          setPressed("repost", !!posts[post]?.reposted);
          for (const comment of comments) {
            const seen = posts[comment.dataset.atmosphereUri!];
            if (!seen) continue;
            comment.querySelector(".atmo-comment-action[data-kind='like']")?.setAttribute("aria-pressed", String(seen.liked));
            comment.querySelector(".atmo-comment-action[data-kind='repost']")?.setAttribute("aria-pressed", String(seen.reposted));
          }
        } catch {
          // The buttons stay as they are; a click still works.
        }
      };

      // Back from the sign-in overlay: finishes what the reader pressed. If
      // signing in failed, the overlay opens again to say so.
      const resumePending = (signed: boolean) => {
        const pending = location.hash.match(/^#atmo-do=([a-z-]+)(?::(.+))?$/);
        if (!pending) return;
        const [, kind, encoded] = pending;
        const uri = encoded ? decodeURIComponent(encoded) : undefined;
        history.replaceState(history.state, "", `${location.pathname}${location.search}#atmosphere-comments`);
        if (!signed) {
          if (result && result !== "signed-in" && SIGN_IN_HEADINGS[kind]) askToSignIn(kind, uri, message(result));
          return;
        }
        const comment = uri ? document.querySelector<HTMLElement>(`[data-atmosphere-uri="${CSS.escape(uri)}"]`) : null;
        const press = (button: HTMLElement | null | undefined) => {
          if (button?.getAttribute("aria-pressed") !== "true") button?.click();
        };
        (comment ?? this).scrollIntoView({ block: "center" });
        if (kind === "like" || kind === "repost") press(reactButton(kind));
        else if (kind === "quote") $<HTMLButtonElement>("[data-quote]").click();
        else if (kind === "comment") main.textarea.focus({ preventScroll: true });
        else if (kind === "reply" && comment) openReply(comment, comment.dataset.atmosphereAuthor || t("comment.someone"));
        else if (kind === "comment-like" && comment) press(comment.querySelector<HTMLElement>(".atmo-comment-action[data-kind='like']"));
        else if (kind === "comment-repost" && comment) press(comment.querySelector<HTMLElement>(".atmo-comment-action[data-kind='repost']"));
      };

      const show = async (signed: boolean, handle?: string, displayName?: string, avatar?: string) => {
        if (handle) {
          $<HTMLElement>("[data-preview-name]").textContent = displayName || handle;
          $<HTMLElement>("[data-preview-handle]").textContent = `@${handle}`;
          setAvatar($<HTMLElement>("[data-preview-avatar]"), displayName || handle, avatar);
          setAvatar($<HTMLElement>("[data-me-avatar]"), displayName || handle, avatar);
          $<HTMLElement>("[data-handle]").textContent = `@${handle}`;
        }
        await threadReady;
        if (this.classList.contains("is-inactive")) return;
        isSignedIn = signed;
        commentPrompt.hidden = signed;
        if (subscribePanel) {
          subscribePanel.hidden = false;
          if (signed) void loadSubscribed();
          else forgetSubscribed();
          await finishPendingSubscribe(t, askToSubscribe);
        }
        if (!signed) {
          document.querySelectorAll(".atmo-comment-action--delete, .atmo-comment-action--hide, .atmo-comment-delete").forEach((part) => part.remove());
          composer.hidden = true;
          permissionPanel.hidden = true;
          setPressed("like", false);
          setPressed("repost", false);
          resumePending(false);
          return closeReplies();
        }
        // A sign-in without posting (from an older version, which asked for
        // less): one more permission, asked for before they type.
        composer.hidden = !can("post");
        permissionPanel.hidden = can("post");
        // Which account, as they may have more than one.
        $<HTMLElement>("[data-permission-text]").textContent = t("composer.needsPermission", { handle: handle ? `@${handle}` : "" });
        addCommentActions();
        addDeleteButtons();
        await loadState();
        resumePending(true);
        // Back from approving the delete or hide permission: ask them to
        // confirm the delete or hide they started.
        const pending = location.hash.match(/^#atmo-(delete|hide)=(.+)$/);
        if (pending) {
          history.replaceState(history.state, "", `${location.pathname}${location.search}#atmosphere-comments`);
          const kind = pending[1] as keyof typeof STEPS;
          const comment = document.querySelector<HTMLElement>(`[data-atmosphere-uri="${CSS.escape(decodeURIComponent(pending[2]))}"]`);
          if (comment && (kind === "delete" ? isMine(comment) : isOwner())) {
            comment.scrollIntoView({ block: "center" });
            openPanel(comment, kind);
          }
        }
      };

      // A message from the sign-in round trip (?atmosphere=…), then tidy the address.
      const url = new URL(location.href);
      const result = url.searchParams.get("atmosphere");
      if (result) {
        say(MESSAGE_KEYS[result] ? message(result) : "");
        url.searchParams.delete("atmosphere");
        history.replaceState(history.state, "", url);
      }

      // These need this script, so they're hidden without it.
      this.classList.add("is-loading");
      $<HTMLElement>("[data-view='main']").hidden = false;
      whoIsSignedIn()
        .then((found) => {
          me = found;
          return found.signedIn ? show(true, found.handle, found.displayName, found.avatar) : show(false);
        })
        .catch(() => show(false))
        .finally(() => {
          this.classList.remove("is-loading");
          addCommentActions();
        });
      // Comments arrive later (they're loaded separately), so look again then,
      // and check what a signed-in reader has liked among the new ones.
      let recheck: number | undefined;
      new MutationObserver(() => {
        if (!addCommentActions() || !isSignedIn) return;
        window.clearTimeout(recheck);
        recheck = window.setTimeout(loadState, 300);
      }).observe(document.body, { childList: true, subtree: true });

      // Like and Repost: shown as done straight away, put back if it fails.
      const reactButton = (kind: string) => $<HTMLButtonElement>(`[data-react='${kind}']`);
      const setPressed = (kind: string, on: boolean) => reactButton(kind).setAttribute("aria-pressed", String(on));
      // Liking also recommends the page's Standard.site record: says so.
      if (subscribePanel && document.querySelector('link[rel="site.standard.document"]')) {
        reactButton("like").title = t("actions.likeAndRecommend");
      }
      for (const kind of ["like", "repost"]) {
        reactButton(kind).addEventListener("click", async () => {
          if (!isSignedIn) return askToSignIn(kind);
          const on = reactButton(kind).getAttribute("aria-pressed") !== "true";
          setPressed(kind, on);
          try {
            // Liking the post also recommends the page's Standard.site record, if it has one.
            const document_ = kind === "like" ? document.querySelector('link[rel="site.standard.document"]')?.getAttribute("href") : undefined;
            const response = await send("react", { post, kind, on, document: document_ ?? undefined });
            if (!response.ok) {
              setPressed(kind, !on);
              const { error, permission } = (await response.json()) as { error?: string; permission?: string };
              return handleError(error ?? "error", say, permission);
            }
            say(t(on ? (kind === "like" ? "status.liked" : "status.reposted") : kind === "like" ? "status.likeRemoved" : "status.repostRemoved"));
            showReaction(kind, on);
            this.dispatchEvent(
              new CustomEvent("atmosphere:reacted", {
                detail: { kind, on, author: { did: me.did, handle: me.handle, displayName: me.displayName, avatar: me.avatar } },
                bubbles: true,
              }),
            );
          } catch {
            setPressed(kind, !on);
            say(message("error"));
          }
        });
      }

      const signOutHere = async () => {
        await signOut();
        me = {};
        void show(false);
        setMainMode("comment");
        say(t("status.signedOut"));
      };
      $<HTMLButtonElement>("[data-sign-out]").addEventListener("click", signOutHere);
      $<HTMLButtonElement>("[data-permission-sign-out]").addEventListener("click", signOutHere);
      $<HTMLButtonElement>("[data-permission-continue]").addEventListener("click", () => void askPermission("post"));
    }
  }

  customElements.define("atmosphere-comments", AtmosphereComments);
</script>
